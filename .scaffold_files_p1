                <Route path="intents/position-erfassen" element={<Suspense fallback={<DashboardSkeleton />}><IntentPositionErfassenPage /></Suspense>} />
                <Route path="intents/auftrag-abrechnen" element={<Suspense fallback={<DashboardSkeleton />}><IntentAuftragAbrechnungPage /></Suspense>} />
                {/* </custom:routes> */}
